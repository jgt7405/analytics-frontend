{
  "name": "jthom-analytics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:clean": "rm -rf .next && npm cache clean --force && npm run dev",
    "dev:turbo": "next dev --turbopack --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:changed": "node scripts/lint-changed.mjs",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run type-check && jest --ci",
    "verify:full": "npm run verify && npm run build && npm run size:check && npm run test:e2e",
    "size": "node scripts/route-sizes.mjs",
    "size:check": "node scripts/check-budgets.mjs",
    "baseline:lighthouse": "node scripts/lighthouse-baseline.mjs",
    "baseline:proxy": "node scripts/proxy-probe.mjs",
    "analyze": "ANALYZE=true next build --webpack",
    "clean": "rm -rf .next dist node_modules/.cache || true",
    "clean:all": "rm -rf .next dist node_modules/.cache && npm cache clean --force"
  },
  "dependencies": {
    "@serwist/turbopack": "^9.5.12",
    "@tanstack/react-query": "^5.103.3",
    "@tanstack/react-query-devtools": "^5.103.3",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.1.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.12",
    "lucide-react": "^0.460.0",
    "next": "^16.3.6",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1",
    "serwist": "^9.5.12",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "chrome-launcher": "^1.2.0",
    "critters": "^0.0.25",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "html2canvas": "^1.4.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      "last 2 years",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lighthouse-config": {
    "ci": {
      "collect": {
        "url": [
          "http://localhost:3000/basketball/wins"
        ],
        "startServerCommand": "npm start"
      },
      "assert": {
        "assertions": {
          "categories:performance": [
            "warn",
            {
              "minScore": 0.8
            }
          ],
          "categories:accessibility": [
            "error",
            {
              "minScore": 0.9
            }
          ],
          "categories:best-practices": [
            "warn",
            {
              "minScore": 0.8
            }
          ],
          "categories:seo": [
            "warn",
            {
              "minScore": 0.8
            }
          ]
        }
      },
      "upload": {
        "target": "temporary-public-storage"
      }
    }
  },
  "pwa": {
    "name": "JThom Analytics",
    "short_name": "JThom Analytics",
    "description": "Basketball analytics and projections",
    "theme_color": "#4caf50",
    "background_color": "#ffffff",
    "start_url": "/basketball/wins",
    "display": "standalone",
    "orientation": "portrait-primary"
  },
  "overrides": {
    "@serwist/turbopack": {
      "browserslist": "^4.29.1"
    }
  }
}
